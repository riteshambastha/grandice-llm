# Upstream Ollama instance. Keep this on localhost - the gateway is the only
# component that should be reachable from outside this machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Where the gateway listens. Cloudflare Tunnel connects to this locally, so
# binding to 127.0.0.1 is enough even when serving the public internet.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# Generated by scripts/bootstrap.ps1. Required for the /admin endpoints.
ADMIN_TOKEN=

# Requests per minute allowed for a key that has no explicit limit.
DEFAULT_RPM_LIMIT=120

# Seconds to wait on the upstream. Long generations on a loaded GPU are slow,
# so this is deliberately generous.
REQUEST_TIMEOUT=600

# Protect the local GPU from too many simultaneous generations. Extra requests
# wait in the gateway queue and are visible in the admin dashboard.
MAX_CONCURRENT_REQUESTS=2

# Comma-separated allowed browser origins, or * for any.
CORS_ORIGINS=*

# Ask Ollama to append a usage record to the final SSE chunk of a stream so
# token counts can be logged. Disable if a client chokes on the extra chunk.
INJECT_STREAM_USAGE=true

# Hosted multimodal privacy processing. The model path must already exist
# locally; Grandice never downloads a speech model while handling a request.
PRIVACY_MEDIA_MAX_BYTES=52428800
# Defaults to ~/.grandice/models/faster-whisper-large-v3-turbo.
# PRIVACY_WHISPER_MODEL_PATH=C:\path\to\an\existing\local\model

# Cloudflare Turnstile protects the public contact form. Create a managed
# widget for grand-ice.com and keep its secret out of source control.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact submissions are relayed by FormSubmit and retained in the local
# SQLite database. FormSubmit requires one-time activation from this inbox.
CONTACT_RECIPIENT=ritesh.linux@gmail.com
CONTACT_FORM_ENDPOINT=https://formsubmit.co/ajax/ritesh.linux@gmail.com

# Encrypted database backups. BACKUP_ENCRYPTION_KEY is a URL-safe base64
# encoding of 32 random bytes; scripts/bootstrap.ps1 can generate it.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_LOCAL_RETENTION_DAYS=30
BACKUP_WEEKLY_RETENTION_WEEKS=12
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
BACKUP_STATUS_PATH=data/backup-status.json

# Optional Cloudflare R2 off-site storage. Local encrypted backups continue
# working when this is disabled or temporarily unavailable.
R2_BACKUP_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=grandice-backups
R2_PREFIX=database
